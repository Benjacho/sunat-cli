#!/bin/sh
for arg in "$@"; do
	printf '%s\n' "$arg"
done > "$SUNAT_TEST_BROWSER_ARGS"
input=$(command cat)
printf '%s' "$input" > "$SUNAT_TEST_BROWSER_STDIN"
printf '%s' "${SUNAT_PASSWORD:-}" > "$SUNAT_TEST_BROWSER_ENV"
if [ "${SUNAT_TEST_BROWSER_FAIL:-0}" = "1" ]; then
	printf '%s' "${SUNAT_TEST_BROWSER_ERROR:-browser failed}" >&2
	exit 1
fi
printf '[]\n'
